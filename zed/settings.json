// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_scan_exclusions": ["**/.agents", "**/.claude"],
  "git": {
    "auto_fetch": {
      "interval_secs": 60,
      "enabled": true,
    },
  },
  "diff_view_style": "split",
  "markdown_preview": {
    "max_width": 1200.0,
    "open_markdown_files_in_preview": true,
  },
  "buffer_line_height": "comfortable",
  "window_title_format": "${projectName}${separator}${fileName}",
  "prettier": {
    "parser": "",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "minimap": {
    "thumb": "hover",
    "max_width_columns": 140,
    "current_line_highlight": "all",
    "show": "auto",
  },
  "edit_predictions": {
    "provider": "ollama",
    "ollama": {
      "api_url": "http://localhost:11435",
      "model": "qwen2.5-coder:7b",
      "prompt_format": "infer",
      "max_output_tokens": 256,
    },
  },
  "show_completions_on_input": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "project_panel": {
    "sort_order": "default",
    "file_icons": true,
    "dock": "left",
  },
  "tabs": {
    "file_icons": true,
  },
  "outline_panel": {
    "file_icons": true,
    "dock": "left",
  },
  // Format every file on save. "auto" uses Prettier where Zed allows it (JS, TS,
  // Vue, CSS, JSON, YAML, Markdown, HTML…), resolving the project's own
  // node_modules/prettier and .prettierrc, and the language server elsewhere.
  "format_on_save": "on",
  "formatter": "auto",
  "languages": {
    // Opt out of langauges as needed (eg below)
    "Markdown": { "format_on_save": "off" },
    // Run ESLint's fix-all (import-x/order etc.) before Prettier, like VS Code's
    // "source.fixAll.eslint" code action on save.
    "JavaScript": {
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "TypeScript": {
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "TSX": {
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
    "Vue.js": {
      "prettier": { "allowed": true },
      "show_completions_on_input": true,
      // vtsls must be listed for .vue files, or the Vue server gets "No Project" and template hover/go-to-definition fail.
      "language_servers": ["vue-language-server", "vtsls", "eslint", "..."],
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
    },
  },
  "lsp": {
    // Use the repo's TypeScript (not vtsls's bundled one) so it matches the Vue plugin. Relative to the
    // workspace root, so it only applies in web-monorepo checkouts and is ignored elsewhere.
    "vtsls": {
      "settings": {
        "typescript": { "tsdk": "apps/portal/node_modules/typescript/lib" },
      },
    },
    "eslint": {
      "settings": {
        // For monorepos with no root eslint.config, where each app/lib has its own.
        "workingDirectories": [{ "mode": "auto" }],
      },
    },
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "expand_terminal_card": false,
    "auto_compact": {
      "threshold": "70%",
    },
    "threads_sidebar": {
      "default_width": 150.0,
      "position": "right",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "collapse_untracked_diff": false,
    "tree_view": true,
    "dock": "left",
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": ["sonnet", "opus"],
        "mode": ["auto"],
      },
      "default_config_options": {
        "model": "sonnet",
        "effort": "medium",
        "mode": "auto",
        "fast": false,
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "buffer_font_weight": 400.0,
  "terminal": {
    "font_weight": 400.0,
    "font_size": 14.0,
  },
  // Generated by zed/sync-extensions.sh to match the installed extensions, so
  // install and uninstall in Zed rather than editing this list. Zed installs
  // anything listed that's missing on startup.
  "auto_install_extensions": {
    "1984-theme": true,
    "csv": true,
    "emmet": true,
    "everforest": true,
    "everforest-blurred": true,
    "git-firefly": true,
    "gruvbox-material": true,
    "html": true,
    "material-icon-theme": true,
    "min-theme": true,
    "monokai-pro-ce": true,
    "qwark-theme": true,
    "vue": true,
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Material",
  },
  "context_servers": {
    "posthog": {
      "enabled": true,
      "url": "https://mcp.posthog.com/mcp",
    },
  },
}
